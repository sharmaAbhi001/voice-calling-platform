# ---------- Application ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
FRONTEND_ORIGIN=http://localhost:5173
BACKEND_URL=http://localhost:4000

# ---------- Database ----------
# Local docker-compose default. Change for managed Postgres.
DATABASE_URL=postgres://voiceops:voiceops@localhost:5432/voiceops

# ---------- Authentication ----------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
# Seed admin (scripts/seed.ts)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=Admin@12345

# Shared secret the LiveKit agent uses to call the backend internal API.
AGENT_API_KEY=change-me-agent-key

# ---------- Telephony carrier (PSTN) ----------
# Which carrier terminates the SIP leg: twilio | exotel | plivo | telnyx | none
# Dialling always goes through LiveKit, so the trunk itself is configured in
# LiveKit (see LIVEKIT_SIP_TRUNK_ID). This only selects webhook verification and
# carrier-side call lookups, both optional.
SIP_CARRIER=none
# Caller ID shown to the customer, E.164. Informational: the number actually used
# is the one attached to the LiveKit trunk.
SIP_CALLER_ID=

# LiveKit outbound SIP trunk credentials. These live here (never in a JSON file
# that git can see); `npm run trunk:build` renders them into the gitignored
# outbound-trunk.json that `lk sip outbound create` consumes.
# Address is the carrier termination domain, no sip: prefix.
#   Twilio: <name>.pstn.twilio.com  Plivo: <trunk_id>.zt.plivo.com
#   Exotel: pstn.in2.exotel.com  (leave both auth_ vars empty - IP whitelisting)
SIP_TRUNK_NAME=outbound
SIP_TRUNK_ADDRESS=
# Trunk credentials created AT THE CARRIER - not your console login.
SIP_TRUNK_AUTH_USERNAME=
SIP_TRUNK_AUTH_PASSWORD=
# Optional. Omit for the carrier default; TLS + SRTP where the carrier supports it.
SIP_TRUNK_TRANSPORT=
SIP_TRUNK_MEDIA_ENCRYPTION=

# Twilio only. Webhook signatures use the account Auth Token, so an API key
# SID/secret pair (SK...) will not work here - use the Account SID (AC...).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# ---------- LiveKit ----------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Outbound SIP trunk id created with `lk sip outbound create`
LIVEKIT_SIP_TRUNK_ID=

# ---------- Email (Resend) ----------
# Powers the forgot-password flow. Without a key the backend still accepts the
# request and logs the reset link instead of mailing it (development only).
RESEND_API_KEY=
# Must be a verified Resend sender. onboarding@resend.dev works for testing but
# only delivers to the address that owns the Resend account.
RESEND_FROM_EMAIL=VoiceOps <onboarding@resend.dev>
# Base URL the reset link points at. Defaults to the first FRONTEND_ORIGIN.
PASSWORD_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# ---------- AI providers ----------
OPENAI_API_KEY=
OPENAI_LLM_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3
# Aura voice used when a template selects Deepgram. English only.
DEEPGRAM_TTS_MODEL=aura-2-asteria-en

# Sarvam AI - Indian-language speech. Selected per template (voiceProvider=SARVAM);
# templates fall back to OpenAI when this key is absent.
SARVAM_API_KEY=
# bulbul:v3 voice. Female: ritu, priya, neha, kavya, shreya. Male: shubh, aditya, rahul.
SARVAM_TTS_SPEAKER=ritu

# ---------- Outbound protection ----------
# Comma separated E.164 prefixes that may be dialled. Keep tight in dev.
ALLOWED_DESTINATION_PREFIXES=+91
# Extra safety while testing: only these exact numbers can be dialled.
# Leave empty to allow any number matching the prefixes above.
DESTINATION_ALLOWLIST=
MAX_CALLS_PER_DAY=50
MAX_CONCURRENT_CALLS=3

# ---------- Storage (recordings) ----------
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/recordings
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ---------- Frontend (Vite) ----------
VITE_API_BASE_URL=http://localhost:4000

