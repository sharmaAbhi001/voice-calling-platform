// Prisma models for the existing Postgres schema.
//
// Two things are deliberately NOT modelled here, because Prisma cannot express
// them and the database is the owner of both:
//   - CHECK constraints on the status/role/category columns. Those columns stay
//     `String` and the union types in @voiceops/shared remain the source of truth.
//   - The pgvector column's indexes, the gin/partial indexes, and the updated_at
//     triggers. They live in the SQL migration; `prisma migrate dev` reports them
//     as drift, which is expected - see backend/prisma/README.md.

generator client {
  provider = "prisma-client-js"
  // pgcrypto (gen_random_uuid) and pgvector are declared on the datasource, which
  // is still behind this flag.
  previewFeatures = ["postgresqlExtensions"]
  // Both the build and the runtime image are node:22-slim (Debian bookworm,
  // OpenSSL 3). The target is pinned so the engine copied out of the build stage
  // is one the production stage can actually load.
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, vector, plpgsql(schema: "pg_catalog")]
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("ADMIN")
  status       String   @default("ACTIVE")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  calls               Call[]
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]

  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("password_reset_tokens")
}

model Contact {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name              String
  phone             String   @unique
  company           String?
  email             String?
  tags              String[] @default([])
  eligibilityStatus String   @default("PENDING") @map("eligibility_status")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  calls Call[]

  @@map("contacts")
}

model KnowledgeBase {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  documents KnowledgeDocument[]
  chunks    KnowledgeChunk[]
  templates Template[]
  calls     Call[]

  @@map("knowledge_bases")
}

model KnowledgeDocument {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  knowledgeBaseId String   @map("knowledge_base_id") @db.Uuid
  title           String
  category        String   @default("OTHER")
  content         String
  status          String   @default("PUBLISHED")
  version         Int      @default(1)
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  knowledgeBase KnowledgeBase    @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  chunks        KnowledgeChunk[]

  @@index([knowledgeBaseId, status], map: "knowledge_documents_kb_idx")
  @@map("knowledge_documents")
}

model KnowledgeChunk {
  id              String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  documentId      String                       @map("document_id") @db.Uuid
  knowledgeBaseId String                       @map("knowledge_base_id") @db.Uuid
  category        String
  chunkIndex      Int                          @map("chunk_index")
  content         String
  // Written and read through raw SQL only: Prisma Client cannot bind an
  // Unsupported column, so chunk writes go through $executeRaw.
  embedding       Unsupported("vector(1536)")?
  createdAt       DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  document      KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  knowledgeBase KnowledgeBase     @relation(fields: [knowledgeBaseId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([knowledgeBaseId, category], map: "knowledge_chunks_kb_idx")
  @@map("knowledge_chunks")
}

model Template {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                   String   @unique
  objective              String
  openingScript          String   @map("opening_script")
  systemPrompt           String   @map("system_prompt")
  closingScript          String   @map("closing_script")
  tone                   String   @default("Professional and friendly")
  language               String   @default("EN")
  voiceProvider          String   @default("OPENAI") @map("voice_provider")
  llmProvider            String   @default("OPENAI") @map("llm_provider")
  voiceName              String?  @map("voice_name")
  backgroundAudio        String   @default("NONE") @map("background_audio")
  qualificationQuestions String[] @default([]) @map("qualification_questions")
  variableSchema         Json     @default("[]") @map("variable_schema")
  knowledgeBaseId        String?  @map("knowledge_base_id") @db.Uuid
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  knowledgeBase KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  calls         Call[]

  @@map("templates")
}

model Call {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactId            String?   @map("contact_id") @db.Uuid
  templateId           String?   @map("template_id") @db.Uuid
  knowledgeBaseId      String?   @map("knowledge_base_id") @db.Uuid
  createdBy            String?   @map("created_by") @db.Uuid
  phone                String
  providerCallId       String?   @map("provider_call_id")
  roomName             String?   @unique @map("room_name")
  sipParticipantId     String?   @map("sip_participant_id")
  direction            String    @default("OUTBOUND")
  status               String    @default("QUEUED")
  outcome              String    @default("ATTEMPTED")
  failureReason        String?   @map("failure_reason")
  variables            Json      @default("{}")
  startedAt            DateTime? @map("started_at") @db.Timestamptz(6)
  answeredAt           DateTime? @map("answered_at") @db.Timestamptz(6)
  endedAt              DateTime? @map("ended_at") @db.Timestamptz(6)
  durationSeconds      Int?      @map("duration_seconds")
  recordingUrl         String?   @map("recording_url")
  transcript           Json?
  summary              String?
  extractedRequirement String?   @map("extracted_requirement")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  contact       Contact?       @relation(fields: [contactId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  template      Template?      @relation(fields: [templateId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  knowledgeBase KnowledgeBase? @relation(fields: [knowledgeBaseId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  creator       User?          @relation(fields: [createdBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "calls_created_at_idx")
  @@index([status], map: "calls_status_idx")
  @@index([outcome], map: "calls_outcome_idx")
  @@index([phone], map: "calls_phone_idx")
  @@map("calls")
}

model WebhookEvent {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider    String
  eventKey    String   @map("event_key")
  eventType   String?  @map("event_type")
  payload     Json
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@unique([provider, eventKey])
  @@map("webhook_events")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId   String?  @map("actor_id") @db.Uuid
  actorType String   @default("USER") @map("actor_type")
  action    String
  subject   String?
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([createdAt(sort: Desc)], map: "audit_logs_created_at_idx")
  @@map("audit_logs")
}
